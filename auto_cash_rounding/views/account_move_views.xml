<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_auto_cash_rounding" model="ir.ui.view">
        <field name="name">account.move.form.auto.cash.rounding</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field
                    name="invoice_cash_rounding_id"
                    options="{'no_create': True}"
                    invisible="move_type not in ('out_invoice', 'in_invoice', 'out_refund', 'in_refund')"
                />
            </xpath>
        </field>
    </record>
</odoo>
