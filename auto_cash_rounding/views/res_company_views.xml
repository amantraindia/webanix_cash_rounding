<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_company_form_view_invoice_cash_rounding" model="ir.ui.view">
        <field name="name">res.company.form.invoice.cash.rounding.default</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="account.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field
                    name="invoice_cash_rounding_id"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>
</odoo>
