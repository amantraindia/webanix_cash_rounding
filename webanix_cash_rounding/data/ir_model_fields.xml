        <field name="name">x_invoice_cash_rounding_id</field>
        <field name="field_description">Default Cash Rounding Method</field>
        <field name="model_id" ref="base.model_res_company" />
        <field name="model">res.company</field>
        <field name="ttype">many2one</field>
        <field name="relation">account.cash.rounding</field>
        <field name="state">manual</field>
    </record>
</odoo>
